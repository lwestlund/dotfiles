#!/usr/bin/env bash

set -euo pipefail

case "$1" in
    copy-selection)
        selection=$(hacksaw -f "-i %i -g %g")
        shotgun $selection - | xclip -selection clipboard -t image/png ;;
    copy-active)
        window=$(hacksaw -f "-i %i")
        shotgun $window - | xclip -selection clipboard -t image/png ;;
    all)
        shotgun ~/Pictures/screenshot_$(date +%Y%m%d)_$(date +%H%M%S).png
esac
